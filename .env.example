# Copy to .env and adjust. Load it with:  uvicorn src.main:app --env-file .env
# (or EnvironmentFile= in the systemd unit, see deploy/zero-cost-gemini.service)
# Keep .env private: chmod 600 .env

# --- Authentication -------------------------------------------------------
# Client keys are created with `python -m src.keys create <name>` and stored
# hashed in keys.json; you do not need to put them here.

# Optional: enables the /admin/keys and /admin/quota endpoints. Use a long random value, e.g.
#   python -c "import secrets; print('sk-admin-' + secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Optional legacy single key, accepted alongside keys.json. Prefer named keys.
PROXY_API_KEY=

# --- Paths ------------------------------------------------------------------
# API_KEYS_FILE=./keys.json
# AGY_BIN=                      # path to agy if it is not on PATH / in ~/.local/bin
# AGY_WORKDIR_ROOT=./.agy-work  # per-request scratch directories
# ACCOUNTS_DIR=./accounts       # only for multi-account mode, see docs/MULTI_ACCOUNT.md

# --- Limits -------------------------------------------------------------------
# MAX_CONCURRENT_REQUESTS=8
# MAX_CONCURRENT_PER_KEY=4
# MAX_REQUEST_BYTES=10485760
# AGY_IDLE_TIMEOUT=180
# AGY_REQUEST_TIMEOUT=600
# QUOTA_BACKOFF_SECONDS=300
